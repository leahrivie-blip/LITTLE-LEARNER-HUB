{
  "name": "little-learner-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Little Learner Hub static website and childcare provider app.",
  "dependencies": {
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "serve": "python3 -m http.server 4173",
    "server": "node server/index.js",
    "check": "node --check server/index.js && node --check app.js && node --check server/launch-check.js && node --check server/billing-check.js",
    "stripe:check": "node server/stripe-check.js",
    "launch:check": "node server/launch-check.js",
    "billing:check": "node server/billing-check.js",
    "test:curriculum-ux": "node scripts/test-curriculum-ux-qa.js",
    "test:curriculum-publish": "node scripts/test-curriculum-admin-publish-flow.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "PWDEBUG=1 playwright test --headed --workers=1",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:blocker": "playwright test e2e/tests/admin-publish.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "^1.49.1"
  }
}
