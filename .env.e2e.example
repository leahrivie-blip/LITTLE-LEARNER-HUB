# Copy to .env.e2e for local overrides (optional — defaults work for isolated E2E runs).
#
# IMPORTANT: These credentials only apply to the isolated test store started by
# `npm run test:e2e`. They do not modify production data.

E2E_PORT=4180
E2E_BASE_URL=http://127.0.0.1:4180

E2E_ADMIN_EMAIL=e2e-admin@test.local
E2E_ADMIN_PASSWORD=e2e-admin-pass-1b07
E2E_ADMIN_ACCESS_CODE=e2e-admin-code-1b07
E2E_ADMIN_NAME=E2E Admin

# Optional: pin an isolated store file (otherwise a temp file is created per run)
# LLH_STORE_PATH=/tmp/llh-e2e-store.json
